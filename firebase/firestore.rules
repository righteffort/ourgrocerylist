rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      // Remove when we want to make public
      function isAllowedUser() {
        return
            request.auth != null &&
            (request.auth.token.email in ['tromer@gmail.com',
                                         'sbromer@gmail.com']
                 || request.auth.token.email.matches('.*@test\\.invalid'));
      }

      function isOwner() {
        return
            request.auth != null &&
            resource != null &&
            resource.data.owner.uid == request.auth.uid;
      }

      function isEditor() {
        return
            request.auth != null &&
            resource != null &&
            resource.data.editors != null &&
            request.auth.uid in resource.data.editors;
      }

      function hasAccess() {
        return isOwner() || isEditor();
      }

      function hasAccessViaList() {
        // The get call is required to get the ACLs on the list --
        // resource.data would be the item itself.
        // Guard against get() returning null when the list document hasn't been
        // committed to the server yet; accessing .data on null causes a rules error.
        let listDoc = get(/databases/$(database)/documents/lists/$(listId));
        return
            request.auth != null &&
            listDoc != null &&
            (request.auth.uid == listDoc.data.owner.uid
                || (listDoc.data.editors != null && request.auth.uid in listDoc.data.editors));
      }

      // List document itself.
      // resource == null means the document doesn't exist; allow authenticated
      // users to read it so ensureListDocument can check existence before creating.
      allow read:
          if
              isAllowedUser() &&
              request.auth != null &&
              (resource == null || hasAccess());  // allow when resource == null for list
      allow update:
          // Disallow unilateral ownership transfer, even by owner.
          if isAllowedUser() && isOwner() && request.resource.data.owner.uid == request.auth.uid;
      allow delete:
          if isAllowedUser() && isOwner();
      allow create:
          if isAllowedUser() && request.auth != null && request.resource.data.owner.uid == request.auth.uid;

      match /items/{itemId} {
        allow read, write:
            if isAllowedUser() && hasAccessViaList();
      }

      // Notifications subcollection — owners and editors can read and delete.
      // Relies on app logic to avoid client A reading/deleting client B's notifications.
      match /notifications/{clientId}/pending/{notificationId} {
        allow read, delete: if isAllowedUser() && hasAccessViaList();
        // Only Cloud Function writes notifications
        allow create, update: if false;
      }
    }
  }
}
