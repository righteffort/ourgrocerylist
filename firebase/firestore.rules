rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      // Remove when we want to make public
      function isAllowedUser() {
        return request.auth != null
            && request.auth.token.email in ['tromer@gmail.com',
                                            'sbromer@gmail.com',
                                            'thr.notes@gmail.com',
                                            'test1@test.invalid',
                                            'test2@test.invalid'
                                           ];
      }

      function isOwner() {
        return request.auth != null
            && resource != null
            && resource.data.owner.uid == request.auth.uid;
      }

      function isEditor() {
        return request.auth != null
            && resource != null
            && resource.data.editors != null
            && request.auth.uid in resource.data.editors;
      }

      function hasAccess() {
        return isOwner() || isEditor();
      }

      function hasAccessViaList() {
        let data = get(/databases/$(database)/documents/lists/$(listId)).data;
        return request.auth != null
            && data != null
            && (request.auth.uid == data.owner.uid
                || (data.editors != null && request.auth.uid in data.editors));
      }

      // List document itself.
      // resource == null means the document doesn't exist; allow authenticated
      // users to read it so ensureListDocument can check existence before creating.
      allow read: if isAllowedUser() && request.auth != null && (resource == null || hasAccess());
      allow update: if isAllowedUser() && isOwner();
      allow delete: if isAllowedUser() && isOwner();
      allow create: if isAllowedUser() && request.auth != null
                        && request.resource.data.owner == request.auth.uid;

      // Items subcollection
      match /items/{itemId} {
        allow read, write: if isAllowedUser() && hasAccessViaList();
      }

      // Notifications subcollection — clients read/delete their own
      match /notifications/{clientId}/pending/{notificationId} {
        allow read, delete: if isAllowedUser() && hasAccessViaList();
        // Only Cloud Function writes notifications
        allow create, update: if false;
      }
    }
  }
}